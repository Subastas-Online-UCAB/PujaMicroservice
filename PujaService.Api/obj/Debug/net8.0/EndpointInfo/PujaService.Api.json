{
  "openapi": "3.0.4",
  "info": {
    "title": "PujaService.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Pujas": {
      "post": {
        "tags": [
          "Pujas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarPujaCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarPujaCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarPujaCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Pujas/subasta/{subastaId}": {
      "get": {
        "tags": [
          "Pujas"
        ],
        "summary": "Obtiene todas las pujas registradas para una subasta específica.",
        "parameters": [
          {
            "name": "subastaId",
            "in": "path",
            "description": "ID de la subasta para la cual se desean consultar las pujas.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pujas obtenida exitosamente."
          },
          "400": {
            "description": "La solicitud no es válida (por ejemplo, ID vacío o malformado)."
          },
          "500": {
            "description": "Ocurrió un error interno al procesar la solicitud."
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegistrarPujaCommand": {
        "type": "object",
        "properties": {
          "subastaId": {
            "type": "string",
            "nullable": true
          },
          "usuarioId": {
            "type": "string",
            "nullable": true
          },
          "monto": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}